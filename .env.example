# Exemplo sem credenciais reais. Copie para .env e substitua os placeholders.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_ALFANUMERICA_LONGA
POSTGRES_DB=contagou_ai
DATABASE_URL=postgresql://postgres:SUBSTITUA_POR_SENHA_ALFANUMERICA_LONGA@postgres:5432/contagou_ai
OPENAI_API_KEY=SUBSTITUA_PELA_SUA_CHAVE
MIN_SIMILARITY=0.55
# Versao de release fixa; a execucao Docker ainda precisa ser validada.
N8N_IMAGE=n8nio/n8n:2.43.1
